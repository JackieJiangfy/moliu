# 墨流 配置文件
# 复制此文件为 .env 并填入你的 API Key
MO_DEEPSEEK_API_KEY=sk-your-key-here
MO_DEEPSEEK_BASE_URL=https://api.deepseek.com
MO_DEEPSEEK_MODEL=deepseek-chat

# === 墨脉图同步（可选，留空则不同步） ===
# 启用后，quickstart/write 生成的角色/世界观/叙述者/章节会自动推送到墨脉图后端
MO_MOMAITU_BASE_URL=http://127.0.0.1:8080/api
MO_MOMAITU_USERNAME=
MO_MOMAITU_PASSWORD=
# 在墨脉图创建小说后得到的小说ID
MO_MOMAITU_NOVEL_ID=
