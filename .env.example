# 墨流 配置文件
# 复制此文件为 .env 并按需修改
# 所有字段前缀为 MO_

# === DeepSeek API(必填) ===
MO_DEEPSEEK_API_KEY=sk-your-key-here
MO_DEEPSEEK_BASE_URL=https://api.deepseek.com
MO_DEEPSEEK_MODEL=deepseek-chat
# 请求超时(秒)
MO_DEEPSEEK_TIMEOUT=120
# 失败重试次数(仅重试 5xx / 429 / 超时)
MO_DEEPSEEK_MAX_RETRIES=3

# === 路径(可选,默认相对项目根) ===
# MO_DATA_DIR=data
# MO_OUTPUT_DIR=output/chapters
# MO_PROMPT_DIR=moliu/prompts/templates

# === 生成参数(可选) ===
# MO_DEFAULT_TEMPERATURE=0.8
# MO_DEFAULT_MAX_TOKENS=4096
# MO_CHAPTER_MIN_WORDS=1800
# MO_CHAPTER_MAX_WORDS=3500

# === 墨脉图同步(可选,默认禁用) ===
# 墨流已内建关系图谱(relationships.json + foreshadows.json + 角色卡),
# 章节生成时会自动注入角色出场间隔 / 伏笔年龄 / 关系张力提示。
# 此项仅用于把数据额外推送到外部墨脉图后端 — 不配置也完全可用。
# MO_MOMAITU_BASE_URL=http://127.0.0.1:8080/api
# MO_MOMAITU_USERNAME=
# MO_MOMAITU_PASSWORD=
# 在墨脉图创建小说后得到的小说ID
# MO_MOMAITU_NOVEL_ID=
